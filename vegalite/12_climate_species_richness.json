{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 700,
  "height": 450,

  "data": {
    "url": "data/12_climate_species_richness.csv"
  },

  "params": [
    {
      "name": "seasonSelect",
      "value": "All",
      "bind": {
        "input": "radio",
        "options": [
          "All",
          "Summer",
          "Autumn",
          "Winter",
          "Spring"
        ],
        "name": "Season: "
      }
    }
  ],

  "transform": [
    {
      "filter": "seasonSelect == 'All' || datum.season == seasonSelect"
    },
    {
      "calculate": "datum.observation_count / 1000",
      "as": "observation_k"
    }
  ],

  "layer": [

    {
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 58,
        "opacity": 0.48,
        "color": "#A7AFB5",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },

      "encoding": {

        "x": {
          "field": "observation_k",
          "type": "quantitative",
          "title": "Recorded Observations (k)",

          "scale": {
            "zero": true,
            "domain": [
              0,
              14
            ]
          },

          "axis": {
            "grid": true,
            "gridColor": "#ecece8",
            "gridOpacity": 0.8,

            "domainColor": "#888888",
            "tickColor": "#888888",

            "labelFontSize": 11,
            "titleFontSize": 12,
            "titleFontWeight": "bold",

            "titlePadding": 9
          }
        },

        "y": {
          "field": "species_richness",
          "type": "quantitative",
          "title": "Recorded Species Richness",

          "scale": {
            "zero": true,
            "domain": [
              0,
              800
            ]
          },

          "axis": {
            "grid": true,
            "gridColor": "#ecece8",
            "gridOpacity": 0.8,

            "domainColor": "#888888",
            "tickColor": "#888888",

            "labelFontSize": 11,
            "titleFontSize": 12,
            "titleFontWeight": "bold",

            "titlePadding": 10
          }
        },

        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },

          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },

          {
            "field": "month",
            "type": "ordinal",
            "title": "Month"
          },

          {
            "field": "season",
            "type": "nominal",
            "title": "Season"
          },

          {
            "field": "observation_count",
            "type": "quantitative",
            "title": "Observation records",
            "format": ","
          },

          {
            "field": "species_richness",
            "type": "quantitative",
            "title": "Recorded species",
            "format": ","
          },

          {
            "field": "mean_temperature_c",
            "type": "quantitative",
            "title": "Mean temperature (°C)",
            "format": ".1f"
          },

          {
            "field": "mean_rainfall_mm",
            "type": "quantitative",
            "title": "Mean rainfall (mm)",
            "format": ".1f"
          }
        ]
      }
    },


    {
      "transform": [
        {
          "loess": "species_richness",
          "on": "observation_k",
          "bandwidth": 0.35
        }
      ],

      "mark": {
        "type": "line",
        "color": "#39434A",
        "strokeWidth": 3
      },

      "encoding": {

        "x": {
          "field": "observation_k",
          "type": "quantitative"
        },

        "y": {
          "field": "species_richness",
          "type": "quantitative"
        }
      }
    }

  ],

  "config": {

    "background": "transparent",

    "font": "Arial",

    "view": {
      "stroke": "transparent"
    }
  }
}
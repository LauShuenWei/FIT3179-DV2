{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 760,
  "height": 330,

  "data": {
    "url": "data/07_seasonal_composition.csv"
  },

  "params": [
    {
      "name": "groupSelect",
      "value": "All",
      "bind": {
        "input": "radio",
        "options": [
          "All",
          "Bird",
          "Mammal",
          "Reptile",
          "Amphibian"
        ],
        "labels": [
          "All",
          "Bird",
          "Mammal",
          "Reptile",
          "Amphibian"
        ],
        "name": "Animal group: "
      }
    }
  ],

  "transform": [
    {
      "filter": "groupSelect == 'All' || datum.animal_group == groupSelect"
    },

    {
      "calculate": "datum.month_name == 'Dec' || datum.month_name == 'Jan' || datum.month_name == 'Feb' ? 'Summer' : datum.month_name == 'Mar' || datum.month_name == 'Apr' || datum.month_name == 'May' ? 'Autumn' : datum.month_name == 'Jun' || datum.month_name == 'Jul' || datum.month_name == 'Aug' ? 'Winter' : 'Spring'",
      "as": "season"
    },

    {
      "calculate": "datum.season == 'Summer' ? 1 : datum.season == 'Autumn' ? 2 : datum.season == 'Winter' ? 3 : 4",
      "as": "season_order"
    },

    {
      "aggregate": [
        {
          "op": "sum",
          "field": "observation_count",
          "as": "season_observations"
        }
      ],
      "groupby": [
        "year",
        "season",
        "season_order"
      ]
    },

    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "season_observations",
          "as": "year_total"
        }
      ],
      "groupby": [
        "year"
      ]
    },

    {
      "calculate": "(datum.season_observations / datum.year_total) * 100",
      "as": "season_percentage"
    },

    {
      "calculate": "format(datum.season_percentage, '.1f') + '%'",
      "as": "percentage_label"
    },

    {
      "calculate": "groupSelect == 'All' ? 'All animal groups' : groupSelect",
      "as": "selected_group"
    }
  ],

  "layer": [
    {
      "params": [
        {
          "name": "seasonHover",
          "select": {
            "type": "point",
            "fields": [
              "season"
            ],
            "on": "pointerover",
            "clear": "pointerout",
            "toggle": false
          }
        }
      ],

      "mark": {
        "type": "area",
        "line": {
          "color": "#ffffff",
          "strokeWidth": 2
        }
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",

          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "titleFontSize": 13
          }
        },

        "y": {
          "field": "season_percentage",
          "type": "quantitative",
          "title": "Share of observations (%)",
          "stack": "zero",

          "scale": {
            "domain": [
              0,
              100
            ]
          },

          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],

            "labelExpr": "datum.value + '%'",

            "grid": true,
            "gridColor": "#eeeeee",
            "gridOpacity": 0.6
          }
        },

        "color": {
          "field": "season",
          "type": "nominal",

          "sort": [
            "Summer",
            "Autumn",
            "Winter",
            "Spring"
          ],

          "scale": {
            "domain": [
              "Spring",
              "Summer",
              "Autumn",
              "Winter"
            ],
            "range": [
              "#C6CEDBFF",
              "#FFD6A5",
              "#E6C4B7",
              "#B7DDDA"
            ]
          },

          "legend": {
            "title": "Season",
            "orient": "right",
            "labelFontSize": 12,
            "titleFontSize": 12,
            "symbolType": "circle"
          }
        },

        "opacity": {
          "condition": {
            "param": "seasonHover",
            "value": 1,
            "empty": true
          },
          "value": 0.18
        },

        "order": {
          "field": "season_order",
          "type": "quantitative",
          "sort": "ascending"
        },

        "tooltip": [
          {
            "field": "selected_group",
            "type": "nominal",
            "title": "Animal group"
          },

          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },

          {
            "field": "season",
            "type": "nominal",
            "title": "Season"
          },

          {
            "field": "season_observations",
            "type": "quantitative",
            "title": "Observation records",
            "format": ","
          },

          {
            "field": "percentage_label",
            "type": "nominal",
            "title": "Share of year"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "transparent",

    "view": {
      "stroke": "transparent"
    },

    "font": "Arial",

    "axis": {
      "domainColor": "#999999",
      "tickColor": "#999999"
    }
  }
}
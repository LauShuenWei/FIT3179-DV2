{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 760,
  "height": 285,

  "data": {
    "url": "data/10_rainfall_by_group.csv"
  },

  "transform": [
    {
      "calculate": "format(datum.median, '.0f') + ' mm median'",
      "as": "median_label"
    }
  ],

  "encoding": {
    "y": {
      "field": "animal_group",
      "type": "nominal",

      "sort": [
        "Bird",
        "Mammal",
        "Reptile",
        "Amphibian"
      ],

      "title": null,

      "axis": {
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelPadding": 12,
        "domain": false,
        "ticks": false
      }
    },

    "color": {
      "field": "animal_group",
      "type": "nominal",

      "scale": {
        "domain": [
          "Bird",
          "Mammal",
          "Reptile",
          "Amphibian"
        ],

        "range": [
          "#729fc7",
          "#d5a354",
          "#67a98d",
          "#c989ae"
        ]
      },

      "legend": null
    },

    "tooltip": [
      {
        "field": "animal_group",
        "type": "nominal",
        "title": "Animal group"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Observation records",
        "format": ","
      },
      {
        "field": "median",
        "type": "quantitative",
        "title": "Median rainfall",
        "format": ".1f"
      },
      {
        "field": "mean",
        "type": "quantitative",
        "title": "Mean rainfall",
        "format": ".1f"
      }
    ]
  },

  "layer": [

    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "opacity": 0.85
      },

      "encoding": {
        "x": {
          "field": "lower_whisker",
          "type": "quantitative",

          "title": "Monthly rainfall (mm)",

          "scale": {
            "zero": true
          },

          "axis": {
            "grid": true,
            "gridColor": "#ecebe6",
            "gridOpacity": 0.8,
            "titleFontSize": 12,
            "labelFontSize": 11,
            "titlePadding": 10
          }
        },

        "x2": {
          "field": "upper_whisker"
        }
      }
    },

    {
      "mark": {
        "type": "bar",
        "size": 34,
        "opacity": 0.55,
        "cornerRadius": 2
      },

      "encoding": {
        "x": {
          "field": "q1",
          "type": "quantitative"
        },

        "x2": {
          "field": "q3"
        }
      }
    },

    {
      "mark": {
        "type": "tick",
        "thickness": 3,
        "size": 34,
        "color": "#3e403c"
      },

      "encoding": {
        "x": {
          "field": "median",
          "type": "quantitative"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "diamond",
        "size": 85,
        "fill": "#ffffff",
        "strokeWidth": 2
      },

      "encoding": {
        "x": {
          "field": "mean",
          "type": "quantitative"
        },

        "stroke": {
          "field": "animal_group",
          "type": "nominal",

          "scale": {
            "domain": [
              "Bird",
              "Mammal",
              "Reptile",
              "Amphibian"
            ],

            "range": [
              "#729fc7",
              "#d5a354",
              "#67a98d",
              "#c989ae"
            ]
          },

          "legend": null
        }
      }
    },

    {
      "mark": {
        "type": "tick",
        "thickness": 2,
        "size": 18
      },

      "encoding": {
        "x": {
          "field": "lower_whisker",
          "type": "quantitative"
        }
      }
    },

    {
      "mark": {
        "type": "tick",
        "thickness": 2,
        "size": 18
      },

      "encoding": {
        "x": {
          "field": "upper_whisker",
          "type": "quantitative"
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 9,
        "dy": -23,
        "font": "Arial",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#555851"
      },

      "encoding": {
        "x": {
          "field": "median",
          "type": "quantitative"
        },

        "text": {
          "field": "median_label",
          "type": "nominal"
        }
      }
    }

  ],

  "config": {
    "background": "transparent",

    "view": {
      "stroke": "transparent"
    },

    "font": "Arial",

    "axis": {
      "domainColor": "#999999",
      "tickColor": "#999999",
      "labelColor": "#4d504b",
      "titleColor": "#3f423e"
    }
  }
}
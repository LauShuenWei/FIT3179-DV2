{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "data/04_state_group_lollipop.csv"
  },

  "transform": [
    {
      "calculate": "(datum.animal_group == 'Bird' && datum.state_name == 'Victoria') || (datum.animal_group == 'Mammal' && datum.state_name == 'Queensland') || (datum.animal_group == 'Reptile' && datum.state_name == 'Queensland') || (datum.animal_group == 'Amphibian' && datum.state_name == 'Queensland')",
      "as": "is_top"
    },
    {
      "calculate": "format(datum.percentage, '.1f') + '%'",
      "as": "percentage_label"
    }
  ],

  "facet": {
    "field": "animal_group",
    "type": "nominal",

    "sort": [
      "Bird",
      "Mammal",
      "Reptile",
      "Amphibian"
    ],

    "header": {
      "title": null,

      "labelFont": "Arial",
      "labelFontSize": 17,
      "labelFontWeight": "bold",

      "labelColor": "#111111",

      "labelPadding": 12
    }
  },

  "columns": 2,

  "spec": {

    "width": 355,
    "height": 245,

    "layer": [

      {
        "mark": {
          "type": "rule",

          "color": "#8f9692",

          "strokeWidth": 1.2,
          "strokeDash": [
            4,
            4
          ],

          "opacity": 0.75
        },

        "encoding": {
          "x": {
            "datum": 12.5,
            "type": "quantitative"
          }
        }
      },

      {
        "mark": {
          "type": "rule",

          "strokeWidth": 3
        },

        "encoding": {

          "y": {
            "field": "state_name",
            "type": "nominal",

            "sort": [
              "Australian Capital Territory",
              "New South Wales",
              "Northern Territory",
              "Queensland",
              "South Australia",
              "Tasmania",
              "Victoria",
              "Western Australia"
            ],

            "axis": {
              "title": null,

              "labelFontSize": 11,

              "labelColor": "#3f423f",

              "labelLimit": 190,

              "ticks": false,
              "domain": false
            }
          },

          "x": {
            "field": "percentage",
            "type": "quantitative",

            "title": "Share of Observations (%)",

            "scale": {
              "domain": [
                0,
                50
              ],
              "nice": false
            },

            "axis": {
              "values": [
                0,
                10,
                20,
                30,
                40,
                50
              ],

              "grid": true,

              "gridColor": "#eceeea",
              "gridOpacity": 0.9,

              "domainColor": "#999999",
              "tickColor": "#999999",

              "labelFontSize": 10,

              "titleFontSize": 11,
              "titleFontWeight": "bold",

              "titlePadding": 8
            }
          },

          "x2": {
            "datum": 0
          },

          "color": {
            "field": "animal_group",
            "type": "nominal",

            "scale": {
              "domain": [
                "Bird",
                "Mammal",
                "Reptile",
                "Amphibian"
              ],

              "range": [
                "#729fc7",
                "#d5a354",
                "#67a98d",
                "#c989ae"
              ]
            },

            "legend": null
          },

          "opacity": {
            "condition": {
              "test": "datum.is_top",
              "value": 0.9
            },

            "value": 0.36
          }
        }
      },

      {
        "mark": {
          "type": "point",

          "filled": true,

          "stroke": "#ffffff",
          "strokeWidth": 1
        },

        "encoding": {

          "y": {
            "field": "state_name",
            "type": "nominal",

            "sort": [
              "Australian Capital Territory",
              "New South Wales",
              "Northern Territory",
              "Queensland",
              "South Australia",
              "Tasmania",
              "Victoria",
              "Western Australia"
            ]
          },

          "x": {
            "field": "percentage",
            "type": "quantitative"
          },

          "color": {
            "field": "animal_group",
            "type": "nominal",

            "scale": {
              "domain": [
                "Bird",
                "Mammal",
                "Reptile",
                "Amphibian"
              ],

              "range": [
                "#729fc7",
                "#d5a354",
                "#67a98d",
                "#c989ae"
              ]
            },

            "legend": null
          },

          "size": {
            "condition": {
              "test": "datum.is_top",
              "value": 140
            },

            "value": 85
          },

          "opacity": {
            "condition": {
              "test": "datum.is_top",
              "value": 1
            },

            "value": 0.7
          },

          "tooltip": [
            {
              "field": "animal_group",
              "type": "nominal",
              "title": "Animal group"
            },

            {
              "field": "state_name",
              "type": "nominal",
              "title": "State / territory"
            },

            {
              "field": "percentage",
              "type": "quantitative",
              "title": "Share of observations",
              "format": ".1f"
            },

            {
              "field": "observation_count",
              "type": "quantitative",
              "title": "Observation records",
              "format": ","
            }
          ]
        }
      },

      {
        "transform": [
          {
            "filter": "datum.is_top"
          }
        ],

        "mark": {
          "type": "text",

          "align": "left",
          "baseline": "middle",

          "dx": 9,

          "font": "Arial",
          "fontSize": 11,
          "fontWeight": "bold"
        },

        "encoding": {

          "y": {
            "field": "state_name",
            "type": "nominal",

            "sort": [
              "Australian Capital Territory",
              "New South Wales",
              "Northern Territory",
              "Queensland",
              "South Australia",
              "Tasmania",
              "Victoria",
              "Western Australia"
            ]
          },

          "x": {
            "field": "percentage",
            "type": "quantitative"
          },

          "text": {
            "field": "percentage_label"
          },

          "color": {
            "field": "animal_group",
            "type": "nominal",

            "scale": {
              "domain": [
                "Bird",
                "Mammal",
                "Reptile",
                "Amphibian"
              ],

              "range": [
                "#4e82af",
                "#b47a28",
                "#3e8066",
                "#aa648c"
              ]
            },

            "legend": null
          }
        }
      }

    ]
  },

  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },

  "config": {

    "background": "transparent",

    "font": "Arial",

    "view": {
      "stroke": null
    },

    "facet": {
      "spacing": 35
    }
  }
}
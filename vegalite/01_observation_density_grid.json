{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Wildlife Recording Activity Across Australia",
    "subtitle": "Spatial patterns of citizen-science observation records and recorded species richness, 2018–2024",
    "anchor": "start",
    "fontSize": 22,
    "fontWeight": "bold",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#555555",
    "subtitlePadding": 8
  },

  "width": 980,
  "height": 680,

  "params": [
    {
      "name": "measure",
      "value": "Observation records",
      "bind": {
        "input": "radio",
        "options": [
          "Observation records",
          "Species richness"
        ],
        "name": "Show: "
      }
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "layer": [

    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#f1efe8",
        "stroke": null
      }
    },

    {
      "data": {
        "url": "data/01_observation_density_grid.csv"
      },

      "transform": [
        {
          "filter": "datum.grid_lon >= 112 && datum.grid_lon <= 154.5 && datum.grid_lat >= -44.5 && datum.grid_lat <= -10"
        },
        {
          "calculate": "measure == 'Observation records' ? datum.observation_count : datum.species_richness",
          "as": "selected_value"
        }
      ],

      "mark": {
        "type": "square",
        "filled": true,
        "size": 32,
        "opacity": 1
      },

      "encoding": {

        "longitude": {
          "field": "grid_lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "grid_lat",
          "type": "quantitative"
        },

        "color": {
          "field": "selected_value",
          "type": "quantitative",

          "scale": {
            "type": "pow",
            "exponent": 0.25,
            "zero": true,
            "range": [
              "#b8dfdc",
              "#81c9c3",
              "#4baba6",
              "#268b8d",
              "#146b75",
              "#0b4f60",
              "#053948"
            ]
          },

          "legend": {
            "title": "Selected value per 0.25° grid",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 320,
            "gradientThickness": 14,
            "offset": 10,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 7
          }
        }
      }
    },

    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#ffffff",
        "strokeWidth": 1.1,
        "strokeOpacity": 0.95
      }
    },

    {
      "data": {
        "url": "data/01_observation_density_grid.csv"
      },

      "transform": [
        {
          "filter": "datum.grid_lon >= 112 && datum.grid_lon <= 154.5 && datum.grid_lat >= -44.5 && datum.grid_lat <= -10"
        }
      ],

      "mark": {
        "type": "square",
        "filled": true,
        "size": 60,
        "fillOpacity": 0.001,
        "strokeOpacity": 0
      },

      "encoding": {

        "longitude": {
          "field": "grid_lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "grid_lat",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "observation_count",
            "type": "quantitative",
            "title": "Observation records",
            "format": ","
          },
          {
            "field": "species_richness",
            "type": "quantitative",
            "title": "Species richness",
            "format": ","
          },
          {
            "field": "grid_lat",
            "type": "quantitative",
            "title": "Latitude",
            "format": ".2f"
          },
          {
            "field": "grid_lon",
            "type": "quantitative",
            "title": "Longitude",
            "format": ".2f"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "city": "Melbourne hotspot",
            "lon": 144.96,
            "lat": -37.81
          },
          {
            "city": "Sydney cluster",
            "lon": 151.21,
            "lat": -33.87
          },
          {
            "city": "Brisbane cluster",
            "lon": 153.03,
            "lat": -27.47
          }
        ]
      },

      "transform": [
        {
          "filter": "measure == 'Observation records'"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 70,
        "color": "#173b42",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },

      "encoding": {

        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "Recording hotspot"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "city": "Melbourne hotspot",
            "lon": 144.96,
            "lat": -37.81
          },
          {
            "city": "Sydney cluster",
            "lon": 151.21,
            "lat": -33.87
          },
          {
            "city": "Brisbane cluster",
            "lon": 153.03,
            "lat": -27.47
          }
        ]
      },

      "transform": [
        {
          "filter": "measure == 'Observation records'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 9,
        "dy": -9,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#263f44"
      },

      "encoding": {

        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },

        "text": {
          "field": "city",
          "type": "nominal"
        }
      }
    }

  ],

  "config": {

    "background": "transparent",

    "view": {
      "stroke": "transparent"
    },

    "font": "Arial",

    "legend": {
      "labelColor": "#444444",
      "titleColor": "#333333"
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Where Is Recorded Wildlife Diversity Highest?",
    "subtitle": "Recorded species richness by Australian state or territory, 2018–2024",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "subtitlePadding": 8
  },

  "width": 760,
  "height": 480,

  "data": {
    "url": "data/02_state_species_richness.csv"
  },

  "transform": [
    {
      "lookup": "state_name",
      "from": {
        "data": {
          "url": "data/australia_states.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
        "key": "properties.state_name_2021"
      },
      "as": "geo"
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "fields": [
          "state_name"
        ],
        "on": "mouseover",
        "clear": "mouseout"
      }
    }
  ],

  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.5
  },

  "encoding": {
    "shape": {
      "field": "geo",
      "type": "geojson"
    },

    "color": {
      "field": "species_richness",
      "type": "quantitative",
      "title": "Recorded Species",
      "scale": {
        "scheme": "greens",
        "domain": [300, 1350]
      },
      "legend": {
        "values": [
          300,
          500,
          700,
          900,
          1100,
          1300
        ],
        "labelExpr": "format(datum.value, ',.0f')",
        "titleFontSize": 12,
        "labelFontSize": 11,
        "gradientLength": 180
      }
    },

    "opacity": {
      "condition": {
        "param": "hover",
        "value": 1
      },
      "value": 0.9
    },

    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "state_code",
        "type": "nominal",
        "title": "Code"
      },
      {
        "field": "species_richness",
        "type": "quantitative",
        "title": "Recorded species",
        "format": ","
      },
      {
        "field": "observation_count",
        "type": "quantitative",
        "title": "Recorded observations",
        "format": ","
      }
    ]
  },

  "config": {
    "background": "transparent",

    "view": {
      "stroke": "transparent"
    },

    "font": "Arial"
  }
}
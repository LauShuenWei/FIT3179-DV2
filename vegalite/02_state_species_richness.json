{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 820,
  "height": 560,

  "projection": {
    "type": "mercator"
  },

  "params": [
    {
      "name": "hoverState",
      "value": ""
    }
  ],

  "layer": [

    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "lookup": "properties.state_name_2021",
          "from": {
            "data": {
              "url": "data/02_state_species_richness.csv"
            },
            "key": "state_name",
            "fields": [
              "state_code",
              "species_richness",
              "observation_count"
            ]
          }
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.3
      },

      "encoding": {

        "color": {
          "field": "species_richness",
          "type": "quantitative",
          "title": "Recorded species",

          "scale": {
            "domain": [
              300,
              1350
            ],

            "range": [
              "#edf3e8",
              "#d6e5ca",
              "#b7d3a5",
              "#92bd7e",
              "#6fa55d",
              "#4d863f",
              "#2f6d32"
            ]
          },

          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",

            "gradientLength": 320,
            "gradientThickness": 13,

            "titleFontSize": 11,
            "labelFontSize": 10,

            "titlePadding": 6,
            "offset": 12
          }
        },

        "opacity": {
          "condition": {
            "test": "hoverState == '' || datum.properties.state_name_2021 == hoverState",
            "value": 1
          },
          "value": 0.22
        },

        "tooltip": [
          {
            "field": "properties.state_name_2021",
            "type": "nominal",
            "title": "State / territory"
          },

          {
            "field": "species_richness",
            "type": "quantitative",
            "title": "Recorded species",
            "format": ","
          },

          {
            "field": "observation_count",
            "type": "quantitative",
            "title": "Observation records",
            "format": ","
          }
        ]
      }
    },


    {
      "data": {
        "values": [
          {
            "state_name": "Western Australia",
            "label": "Western\nAustralia",
            "lon": 121.5,
            "lat": -25.5
          },

          {
            "state_name": "Northern Territory",
            "label": "Northern\nTerritory",
            "lon": 133.5,
            "lat": -19.5
          },

          {
            "state_name": "South Australia",
            "label": "South\nAustralia",
            "lon": 135,
            "lat": -30
          },

          {
            "state_name": "Queensland",
            "label": "Queensland",
            "lon": 145,
            "lat": -21.5
          },

          {
            "state_name": "New South Wales",
            "label": "New South\nWales",
            "lon": 147,
            "lat": -32.5
          },

          {
            "state_name": "Victoria",
            "label": "Victoria",
            "lon": 144.5,
            "lat": -36.6
          },

          {
            "state_name": "Tasmania",
            "label": "Tasmania",
            "lon": 146.8,
            "lat": -42
          },

          {
            "state_name": "Australian Capital Territory",
            "label": "Australian\nCapital Territory",
            "lon": 149.2,
            "lat": -35.4
          }
        ]
      },

      "mark": {
        "type": "text",

        "font": "Arial",
        "fontSize": 12,
        "fontWeight": "bold",

        "lineBreak": "\n",

        "fill": "#1f1f1f"
      },

      "encoding": {

        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },

        "text": {
          "field": "label",
          "type": "nominal"
        },

        "opacity": {
          "condition": {
            "test": "hoverState == '' || datum.state_name == hoverState",
            "value": 1
          },
          "value": 0.18
        }
      }
    }

  ],

  "config": {

    "background": "transparent",

    "font": "Arial",

    "view": {
      "stroke": "transparent"
    },

    "legend": {
      "labelColor": "#555851",
      "titleColor": "#333833"
    }
  }
}
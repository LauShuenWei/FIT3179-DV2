{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "data/11_temperature_distribution_by_group.csv"
  },

  "transform": [
    {
      "calculate": "-datum.percentage",
      "as": "negative_percentage"
    },
    {
      "calculate": "datum.temperature_midpoint * datum.observation_count",
      "as": "weighted_temperature"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "weighted_temperature",
          "as": "weighted_temperature_sum"
        },
        {
          "op": "sum",
          "field": "observation_count",
          "as": "group_observation_total"
        }
      ],
      "groupby": [
        "animal_group"
      ]
    },
    {
      "calculate": "datum.weighted_temperature_sum / datum.group_observation_total",
      "as": "mean_temperature"
    },
    {
      "calculate": "'Mean ' + format(datum.mean_temperature, '.1f') + '°C'",
      "as": "mean_label"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "group_row"
        }
      ],
      "groupby": [
        "animal_group"
      ],
      "sort": [
        {
          "field": "temperature_midpoint",
          "order": "ascending"
        }
      ]
    }
  ],

  "facet": {
    "field": "animal_group",
    "type": "nominal",

    "sort": [
      "Bird",
      "Mammal",
      "Reptile",
      "Amphibian"
    ],

    "header": {
      "title": null,
      "labelFontSize": 15,
      "labelFontWeight": "bold",
      "labelColor": "#252525",
      "labelPadding": 10
    }
  },

  "columns": 2,

  "spec": {
    "width": 265,
    "height": 155,

    "layer": [

      {
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "opacity": 0.72,
          "strokeWidth": 0.8
        },

        "encoding": {
          "x": {
            "field": "temperature_midpoint",
            "type": "quantitative",

            "title": "Mean monthly temperature (°C)",

            "scale": {
              "domain": [
                -2,
                34
              ]
            },

            "axis": {
              "values": [
                -2,
                0,
                5,
                10,
                15,
                20,
                25,
                30,
                34
              ],

              "labelExpr": "datum.value == -2 ? '< 0' : datum.value",

              "labelFontSize": 10,
              "titleFontSize": 11,

              "grid": false
            }
          },

          "y": {
            "field": "negative_percentage",
            "type": "quantitative",
            "title": null,
            "axis": null
          },

          "y2": {
            "field": "percentage"
          },

          "color": {
            "field": "animal_group",
            "type": "nominal",

            "scale": {
              "domain": [
                "Bird",
                "Mammal",
                "Reptile",
                "Amphibian"
              ],

              "range": [
                "#729fc7",
                "#d5a354",
                "#67a98d",
                "#c989ae"
              ]
            },

            "legend": null
          },

          "tooltip": [
            {
              "field": "animal_group",
              "type": "nominal",
              "title": "Animal group"
            },
            {
              "field": "temperature_midpoint",
              "type": "quantitative",
              "title": "Mean monthly temperature (°C)",
              "format": ".1f"
            },
            {
              "field": "observation_count",
              "type": "quantitative",
              "title": "Observation records",
              "format": ","
            },
            {
              "field": "percentage",
              "type": "quantitative",
              "title": "Share of group",
              "format": ".2f"
            }
          ]
        }
      },

      {
        "mark": {
          "type": "rule",
          "stroke": "#666666",
          "strokeWidth": 0.8,
          "opacity": 0.55
        },

        "encoding": {
          "y": {
            "datum": 0
          }
        }
      },

      {
        "transform": [
          {
            "filter": "datum.group_row == 1"
          }
        ],

        "mark": {
          "type": "rule",
          "stroke": "#3f443f",
          "strokeWidth": 1.3,
          "strokeDash": [
            4,
            3
          ],
          "opacity": 0.85
        },

        "encoding": {
          "x": {
            "field": "mean_temperature",
            "type": "quantitative"
          }
        }
      },

      {
        "transform": [
          {
            "filter": "datum.group_row == 1"
          }
        ],

        "mark": {
          "type": "text",
          "font": "Arial",
          "fontSize": 10,
          "fontWeight": "bold",
          "color": "#404540",
          "align": "center",
          "baseline": "bottom",
          "dy": -8
        },

        "encoding": {
          "x": {
            "field": "mean_temperature",
            "type": "quantitative"
          },

          "y": {
            "datum": 0
          },

          "text": {
            "field": "mean_label",
            "type": "nominal"
          }
        }
      }

    ]
  },

  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },

  "config": {
    "background": "transparent",

    "view": {
      "stroke": "transparent"
    },

    "font": "Arial",

    "axis": {
      "domainColor": "#999999",
      "tickColor": "#999999",
      "labelColor": "#50534f",
      "titleColor": "#3f423e"
    },

    "facet": {
      "spacing": 24
    }
  }
}
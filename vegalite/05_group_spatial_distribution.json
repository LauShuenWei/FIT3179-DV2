{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "data/05_group_spatial_distribution.csv"
  },

  "transform": [
    {
      "filter": "datum.grid_lon >= 112 && datum.grid_lon <= 154.5 && datum.grid_lat >= -44.5 && datum.grid_lat <= -10"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "observation_count",
          "as": "group_max"
        }
      ],
      "groupby": [
        "animal_group"
      ]
    },
    {
      "calculate": "(datum.observation_count / datum.group_max) * 100",
      "as": "relative_intensity"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "observation_count",
          "order": "descending"
        }
      ],
      "groupby": [
        "animal_group"
      ]
    },
    {
      "filter": "datum.rank <= 250"
    }
  ],

  "facet": {
    "field": "animal_group",
    "type": "nominal",

    "sort": [
      "Bird",
      "Mammal",
      "Reptile",
      "Amphibian"
    ],

    "header": {
      "title": null,
      "labelFontSize": 16,
      "labelFontWeight": "bold",
      "labelColor": "#222222",
      "labelPadding": 7
    }
  },

  "columns": 2,

  "spec": {
    "width": 370,
    "height": 255,

    "projection": {
      "type": "mercator"
    },

    "layer": [
      {
        "data": {
          "url": "data/australia_states.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },

        "mark": {
          "type": "geoshape",
          "fill": "#f1efe8",
          "stroke": "#b9bbb4",
          "strokeWidth": 0.7
        }
      },

      {
        "mark": {
          "type": "circle",
          "filled": true,
          "opacity": 0.55,
          "stroke": "#ffffff",
          "strokeWidth": 0.35
        },

        "encoding": {
          "longitude": {
            "field": "grid_lon",
            "type": "quantitative"
          },

          "latitude": {
            "field": "grid_lat",
            "type": "quantitative"
          },

          "color": {
            "field": "animal_group",
            "type": "nominal",

            "scale": {
              "domain": [
                "Bird",
                "Mammal",
                "Reptile",
                "Amphibian"
              ],

              "range": [
                "#729fc7",
                "#d5a354",
                "#67a98d",
                "#c989ae"
              ]
            },

            "legend": null
          },

          "size": {
            "field": "relative_intensity",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "domain": [0, 100],
              "range": [8, 360]
            },
            "legend": {
              "title": "Relative intensity within group",
              "orient": "bottom",
              "direction": "horizontal",
              "values": [25, 50, 75, 100],
              "labelExpr": "datum.label + '%'",
              "labelFontSize": 10,
              "titleFontSize": 11
            }
          },

          "tooltip": [
            {
              "field": "animal_group",
              "type": "nominal",
              "title": "Animal group"
            },
            {
              "field": "observation_count",
              "type": "quantitative",
              "title": "Observation records",
              "format": ","
            },
            {
              "field": "species_richness",
              "type": "quantitative",
              "title": "Recorded species",
              "format": ","
            },
            {
              "field": "relative_intensity",
              "type": "quantitative",
              "title": "Relative intensity (%)",
              "format": ".0f"
            }
          ]
        }
      }
    ]
  },

  "spacing": 16,

  "config": {
    "background": "transparent",

    "font": "Arial",

    "view": {
      "stroke": "transparent"
    },

    "legend": {
      "labelColor": "#444444",
      "titleColor": "#333333"
    }
  }
}